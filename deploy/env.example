# ============================================================
# matreko-server 服务器端环境变量模板
# 用法：复制为 /opt/matreko/.env 后修改带 <...> 的占位符
# 该文件含密钥，仅存于服务器，绝不提交进仓库
# ============================================================

# ── Server ──
PORT=3000
NODE_ENV=production

# ── Database ──
# SQLite 持久卷路径（容器启动时由 docker-compose 挂载 ./data -> /data）
DATABASE_URL="file:/data/prod.db"

# ── CORS ──
CORS_ORIGIN=*

# ── 认证（backend §12） ──
# access token 有效期（毫秒），默认 15 分钟
ACCESS_TOKEN_TTL=900000
# refresh token 有效期（毫秒），默认 24 小时
REFRESH_TOKEN_TTL=86400000
# 续期无缝轮换宽限期（毫秒），默认 60 秒
TOKEN_RENEW_GRACE_MS=60000
# 密钥/团队状态缓存 TTL（毫秒），默认 60 秒
KEY_STATUS_CACHE_TTL_MS=60000
# 后台会话有效期（毫秒），默认 30 分钟；每次通过鉴权的 API 调用滑动续期
BACKOFFICE_SESSION_TTL=1800000

# ── 限流（backend §4.5） ──
RATE_LIMIT_TRANSLATE_CAP=20
RATE_LIMIT_TRANSLATE_RATE=20
RATE_LIMIT_OTHER_CAP=50
RATE_LIMIT_OTHER_RATE=50
RATE_LIMIT_ACTIVATE_CAP=5
RATE_LIMIT_ACTIVATE_RATE=1

# ── 端口租约（backend §6.1） ──
HEARTBEAT_INTERVAL=120000
LEASE_TTL=86400000
LEASE_SCAN_INTERVAL=60000

# ── 翻译（backend §7.6） ──
ENGINE_MAX_CHARS=5000
CHUNK_SIZE=4500
LANG_SYNC_CRON="0 4 * * *"

# ── 登录锁定（P0-A-19 AC7） ──
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_MS=1800000

# ── 部署初始化（必填，改成你自己的） ──
PLATFORM_EMAIL=admin@example.com
PLATFORM_INITIAL_PASSWORD=<改为强密码>

# ── 加密密钥（必填，生产必须替换为随机值） ──
# 生成方式：openssl rand -base64 32  （32 字节 base64）
API_KEY_ENC_KEY=<32字节base64，如 openssl rand -base64 32>
JWT_SECRET=<随机长字符串，如 openssl rand -hex 32>
LICENSE_CODE_ENC_KEY=<32字节base64，如 openssl rand -base64 32>
