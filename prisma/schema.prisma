generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── 枚举 ───────────────────────────────

/// 团队状态（只能禁用，不能删除，P0-S-11）
enum TeamStatus {
  ACTIVE
  DISABLED
}

/// 后台账号角色（P0-A-19：平台管理员全系统唯一，主管每团队唯一）
enum AdminRole {
  PLATFORM
  SUPERVISOR
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

/// 密钥状态（一密钥 = 一客服，P0-B-09）
enum LicenseStatus {
  UNUSED
  ACTIVE
  DISABLED
}

/// 端口租约状态（回收 = 置 RELEASED，不物理删除，P0-C-20）
enum LeaseStatus {
  HELD
  RELEASED
}

/// IM 渠道（P0-C-03 AC1）
enum Channel {
  TELEGRAM
  WHATSAPP
}

/**
 * 代理协议（P0-C-18 AC1：客户端支持 SOCKS5 / HTTP(S)）
 * - DIRECT = 未配置代理（本机直连），此时出口地无意义
 * 说明：SQLite 下 Prisma 枚举只落 TEXT，新增协议值只需改这里 + 重新 db push。
 */
enum ProxyProtocol {
  SOCKS5
  HTTP
  HTTPS
  DIRECT
}

enum TranslationEngine {
  GOOGLE
  DEEPL
}

enum TranslationKeyStatus {
  ACTIVE
  EXHAUSTED
  INVALID
  DISABLED
}

enum LangSupportStatus {
  SUPPORTED
  UNSUPPORTED
}

/// 凭据撤销原因（续期替换 / 主动吊销）
enum RevokeReason {
  RENEWED
  REVOKED
}

enum ActorType {
  CLIENT
  SUPERVISOR
  PLATFORM
  SYSTEM
}

// ─────────────────────────────── 模型 ───────────────────────────────

/// 团队（createdAt 不可修改；expiresAt 秒级精确，管理员可改）
model Team {
  id               String     @id @default(cuid())
  name             String
  createdAt        DateTime   @default(now())
  expiresAt        DateTime
  portQuota        Int
  translationQuota Int        @default(1500000)
  translationUsed  Int        @default(0) // 冗余计数，真相源为 TranslationUsageLog
  status           TeamStatus @default(ACTIVE)

  adminAccounts   AdminAccount[]
  licenseKeys     LicenseKey[]
  portLeases      PortLease[]
  channelAccounts ChannelAccount[]
  translationLogs TranslationUsageLog[]

  @@map("teams")
}

/// 后台账号（仅禁用不删除；PLATFORM 全系统唯一）
model AdminAccount {
  id               String        @id @default(cuid())
  role             AdminRole
  email            String        @unique
  passwordHash     String // bcrypt cost=12，不可还原（P0-A-19 AC16）
  teamId           String?
  team             Team?         @relation(fields: [teamId], references: [id])
  status           AccountStatus @default(ACTIVE)
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime      @default(now())

  sessions BackofficeSession[]

  @@map("admin_accounts")
}

/// 密钥（code 存 AES-256-GCM 密文，需展示时解密；不能删除只能禁用）
model LicenseKey {
  id                 String        @id @default(cuid())
  teamId             String
  team               Team          @relation(fields: [teamId], references: [id])
  nickname           String        // 密钥昵称，主管可辨识的自定义名称
  code               String? // AES-256-GCM 密文（iv.ct.tag base64 拼接）
  status             LicenseStatus @default(UNUSED)
  multiDeviceEnabled Boolean       @default(false)
  deviceLimit        Int           @default(5) // 多开设备上限，恒为 5
  createdAt          DateTime      @default(now())

  deviceBindings    DeviceBinding[]
  clientCredentials ClientCredential[]
  portLeases        PortLease[]
  channelAccounts   ChannelAccount[]
  translationLogs   TranslationUsageLog[]

  @@map("license_keys")
}

/// 设备绑定（(keyId, fingerprintHash) 唯一；解绑即删除记录）
model DeviceBinding {
  id              String     @id @default(cuid())
  keyId           String
  licenseKey      LicenseKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  fingerprintHash String // SHA-256(fingerprint + keyId)
  deviceLabel     String?
  boundAt         DateTime   @default(now())

  @@unique([keyId, fingerprintHash])
  @@map("device_bindings")
}

/// 客户端凭据（每个激活成功的设备一条；refresh token 旋转式替换）
model ClientCredential {
  id                    String     @id @default(cuid())
  keyId                 String
  licenseKey            LicenseKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  deviceFingerprintHash String
  clientId              String     @unique // 限流维度 key
  refreshTokenHash      String     @unique
  expiresAt             DateTime // 滑动续期
  createdAt             DateTime   @default(now())
  /// 最近一次续期时间（语义＝凭据轮换）；access TTL 3 天，故**不能**当作在线心跳
  lastRenewedAt         DateTime   @default(now())
  /// 设备活跃时间（语义＝设备心跳保活，由 POST /api/client/ports/heartbeat 刷新）；
  /// 从未上报过心跳的存量设备为 null，在线判据回落 lastRenewedAt
  lastActiveAt          DateTime?

  @@map("client_credentials")
}

/// 端口占用（服务端记录为准；回收 = 置 RELEASED）
model PortLease {
  id                String      @id @default(cuid())
  teamId            String
  team              Team        @relation(fields: [teamId], references: [id])
  keyId             String
  licenseKey        LicenseKey  @relation(fields: [keyId], references: [id])
  clientId          String
  channelAccountKey String // 客户端原始上报值（历史兼容：可能为 'channel:id' 或裸 id）
  /// 规范化账号标识（与 ChannelAccount.channelAccountId 精确匹配；老客户端可能为 null）
  channelAccountId  String?
  status            LeaseStatus @default(HELD)
  acquiredAt        DateTime    @default(now())
  lastSeenAt        DateTime    @default(now())
  releasedAt        DateTime?
  /// IM 渠道账号业务状态：ONLINE / WAITING_QR / OFFLINE，仅展示用途（由客户端心跳上报）
  channelStatus     String?

  @@index([clientId, channelAccountId])
  @@map("port_leases")
}

/// 渠道账号登记（P0-C-03 AC1 / P0-B-10 AC1）
///
/// 服务端**仅登记存在性元数据**（渠道 / 别名 / 归属 / 代理出口摘要）；代理凭据、指纹、
/// 数据目录等配置内容仍只存客户端本地，不违反 P0-C-18 AC18「各设备账号配置互相独立、不做同步」。
/// 与 backend.md §3.3 B 的「本地账号配置库」契约是两张不同的表，勿混淆（见 channel-account-design.md §2.3）。
///
/// 代理出口**拆两个机器可读字段**而非存展示串「SOCKS5·新加坡」：
/// - `proxyProtocol` 协议（闭集，枚举）；`proxyRegion` 出口地区码（ISO 3166-1 alpha-2，如 SG/HK）。
/// - 理由：展示格式/语言可变（存串=把 UI 决策写进库，改版要数据迁移）；需要按地区或协议
///   筛选统计（两字段可 where/groupBy，存串只能 LIKE）；可强校验避免「socks5·新加坡 /
///   新加坡 socks5」这类脏数据。展示串由前端拼（user-web `utils/proxy.ts`）。
model ChannelAccount {
  id               String     @id @default(cuid())
  teamId           String
  team             Team       @relation(fields: [teamId], references: [id])
  keyId            String
  licenseKey       LicenseKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  /// 归属客户端（= ClientCredential.clientId，按 (keyId, 指纹) 确定性派生，同设备恒定）
  clientId         String
  /// 客户端侧稳定标识（客户端本地 port.id，单机内唯一）
  channelAccountId String
  channel          Channel
  /// 客服自定义别名（P0-C-18「账号名称」，≤64 字符）
  accountName      String
  /// 代理协议；null = 客户端尚未上报（未知），DIRECT = 显式本机直连
  proxyProtocol    ProxyProtocol?
  /// 代理出口地区码：ISO 3166-1 alpha-2 大写（如 SG / HK）；DIRECT 或未知时为 null
  proxyRegion      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  /// 软删除（P0-C-18 AC15 删除账号配置）；主管端默认不展示
  deletedAt        DateTime?

  @@unique([clientId, channelAccountId])
  @@index([teamId, deletedAt])
  @@index([keyId])
  @@index([teamId, proxyRegion])
  @@map("channel_accounts")
}

/// 翻译 API Key（AES-256-GCM 加密存储；管理后台唯一持有）
model TranslationKey {
  id                String               @id @default(cuid())
  engine            TranslationEngine
  name              String
  keyEncrypted      String
  status            TranslationKeyStatus @default(ACTIVE)
  quotaLimit        Int? // null = 不设限
  quotaUsed         Int                  @default(0) // 冗余计数
  lastFailureReason String?
  lastUsedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  translationLogs TranslationUsageLog[]

  @@map("translation_keys")
}

/// 引擎语种能力（(engine, languageCode) 唯一）
model EngineLanguageSupport {
  id           String            @id @default(cuid())
  engine       TranslationEngine
  languageCode String // ISO 639-1
  status       LangSupportStatus @default(SUPPORTED)
  updatedAt    DateTime          @updatedAt

  @@unique([engine, languageCode])
  @@map("engine_language_supports")
}

/// 翻译用量日志（计量唯一真相源；只在翻译接口返回成功时插入）
model TranslationUsageLog {
  id             String            @id @default(cuid())
  teamId         String
  team           Team              @relation(fields: [teamId], references: [id])
  keyId          String?
  translationKey TranslationKey?   @relation(fields: [keyId], references: [id])
  engine         TranslationEngine
  chars          Int // 该次翻译的原文字符数
  success        Boolean           @default(true) // 恒 true，失败不落此表
  createdAt      DateTime          @default(now())
  licenseKey     LicenseKey?       @relation(fields: [licenseKeyId], references: [id])
  licenseKeyId   String?

  @@index([teamId, createdAt])
  @@index([keyId, createdAt])
  @@map("translation_usage_logs")
}

/// Key 每日用量聚合缓存（T5-03：每小时聚合一次 + 实时计数兜底，避免每次查询扫全表）
model KeyDailyUsage {
  id        String            @id @default(cuid())
  keyId     String
  date      String // YYYY-MM-DD（按 UTC 日期聚合）
  engine    TranslationEngine
  chars     Int  @default(0) // 当日累计字符
  calls     Int  @default(0) // 当日累计调用次数
  failures  Int  @default(0) // 当日累计失败次数（进程内计数快照，重启后从此值继续）
  updatedAt DateTime          @updatedAt

  @@unique([keyId, date])
  @@index([keyId, date])
  @@map("key_daily_usages")
}

/// 审计日志（凭据篡改、指纹不匹配、团队/密钥禁用、配额调整等）
model AuditLog {
  id        String    @id @default(cuid())
  actorType ActorType
  actorId   String
  action    String
  detail    String? // JSON
  ip        String?
  createdAt DateTime  @default(now())

  @@index([action, createdAt])
  @@map("audit_logs")
}

/// 凭据撤销名单（续期轮换宽限期 + 主动吊销）
model RevokedToken {
  id       String       @id @default(cuid())
  jti      String       @unique
  reason   RevokeReason
  revokeAt DateTime     @default(now())

  @@index([revokeAt])
  @@map("revoked_tokens")
}

/// 后台会话（不透明随机串，存 SHA-256 哈希；有效期 8h）
model BackofficeSession {
  id        String       @id @default(cuid())
  accountId String
  account   AdminAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  expiresAt DateTime
  createdAt DateTime     @default(now())
  revokedAt DateTime? // 登出 / 改密 / 重置置位

  @@map("backoffice_sessions")
}
