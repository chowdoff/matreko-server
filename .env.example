# ── Server ──
PORT=3000
NODE_ENV=development

# ── Database ──
DATABASE_URL="file:./dev.db"

# ── CORS ──
CORS_ORIGIN=*

# ── 认证（backend §12） ──
# access token 有效期（毫秒），3 天
ACCESS_TOKEN_TTL=259200000
# refresh token 有效期（毫秒），14 天；每次续期滑动重置，用于回收长期离线设备
# 客户端不缓存明文密钥，refreshToken 是唯一的免密钥凭证，过期即须重输密钥
# 若要覆盖春节长假 / 设备长期闲置，建议调至 90 天（7776000000）或更长
REFRESH_TOKEN_TTL=1209600000
# 续期无缝轮换宽限期（毫秒），默认 60 秒
TOKEN_RENEW_GRACE_MS=60000
# 密钥/团队状态缓存 TTL（毫秒），默认 60 秒
KEY_STATUS_CACHE_TTL_MS=60000
# 后台会话有效期（毫秒），默认 30 分钟；每次通过鉴权的 API 调用滑动续期
BACKOFFICE_SESSION_TTL=1800000

# ── 限流（backend §4.5） ──
RATE_LIMIT_TRANSLATE_CAP=20
RATE_LIMIT_TRANSLATE_RATE=20
RATE_LIMIT_OTHER_CAP=50
RATE_LIMIT_OTHER_RATE=50
RATE_LIMIT_ACTIVATE_CAP=5
RATE_LIMIT_ACTIVATE_RATE=1

# ── 端口租约（backend §6.1） ──
HEARTBEAT_INTERVAL=120000
LEASE_TTL=86400000
LEASE_SCAN_INTERVAL=60000

# ── 翻译（backend §7.6） ──
ENGINE_MAX_CHARS=5000
CHUNK_SIZE=4500
LANG_SYNC_CRON="0 4 * * *"

# ── 登录锁定（P0-A-19 AC7） ──
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_MS=1800000

# ── 部署初始化（P0-A-19 AC1，必填） ──
PLATFORM_EMAIL=admin@matreko.local
PLATFORM_INITIAL_PASSWORD=Admin12345

# ── 加密密钥（必填） ──
# 翻译 API Key 的 AES-256-GCM 加密密钥（32 字节，示例仅用于开发环境）
API_KEY_ENC_KEY=FqcDy5Ux+pCGw90ZnxspoIFqgxIlIc96oxfpj2pL8HY=
# JWT 签名密钥（HS256）
JWT_SECRET=dev-only-jwt-secret-change-in-production
# 密钥码 AES-256-GCM 加解密主密钥（32 字节 base64，示例仅用于开发环境）
LICENSE_CODE_ENC_KEY=dev-only-license-key-change-in-production-32b
# ── clientId 派生密钥（可选，backend §5.1.2） ──
# 用于 HMAC 派生 clientId（同一设备指纹 + 同一密钥重复激活返回同一 clientId）。
# 不配置则自动回落 JWT_SECRET（存量部署零配置生效）。
# ⚠️ 配置后必须保持恒定：变更等于重置全部设备身份（同一设备重新激活会拿到新 clientId）。
# CLIENT_ID_SECRET=dev-only-client-id-secret-change-in-production
